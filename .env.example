# ─────────────────────────────────────────────────────────────────────────────
# Neura Agents — environment template
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Everything here is read by neura-core/config.py, which fails fast at boot on
# anything missing or malformed — a misconfigured deploy should not start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NEURA_ENV=development                  # development | staging | production
NEURA_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
NEURA_API_HOST=0.0.0.0
NEURA_API_PORT=8000

# Signs API keys, cursors and webhook payloads. Generate per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NEURA_SECRET_KEY=change-me

# The `guard` node's injection rules and PII redaction. On by default, and this
# is a MEASUREMENT switch rather than a deployment one: `make eval-guard-off`
# sets it to prove that injection resistance comes from the policy engine and
# not from the guard (ADR-0011). Leaving it off in a deployment removes PII
# tokenisation before the cloud REASONER, which is the half that actually
# matters. The node logs a warning on every turn while it is off.
NEURA_GUARD_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────────
# Port 5433, not the default 5432: the dev stack avoids colliding with a
# Postgres you may already run. Override POSTGRES_PORT if 5433 is taken too.
#
# TWO URLS, ON PURPOSE.
#
# DATABASE_URL is `neura_app` — an unprivileged role. Row-Level Security does
# not apply to superusers or BYPASSRLS roles, so connecting as the owner
# `neura` would disable tenant isolation with no error of any kind. The app
# refuses to report itself ready if it detects this.
#
# DATABASE_MIGRATION_URL is the owner, because CREATE TABLE and CREATE POLICY
# are exactly the privileges the serving process must not hold.
DATABASE_URL=postgresql+asyncpg://neura_app:neura_app@localhost:5433/neura
DATABASE_MIGRATION_URL=postgresql+asyncpg://neura:neura@localhost:5433/neura
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Encryption ───────────────────────────────────────────────────────────────
# Key-Encryption Key for envelope encryption of tenant store credentials.
# Env var is acceptable for a pilot; cloud KMS is required before real
# merchants — see docs/architecture/security-model.md §12.3.
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
NEURA_KEK=change-me-base64-32-bytes

# ── LLM ──────────────────────────────────────────────────────────────────────
# Selects a role map. Application code names ROLES, never models.
#   ollama-dev  → local Ollama (development, zero cost)
#   cloud-prod  → cloud API (production)
#   sovereign   → customer-hosted Ollama
#   hybrid      → local router/embedder + cloud reasoner (often the best point)
NEURA_ROLE_MAP=ollama-dev

# Ollama — OpenAI-compatible endpoint. api_key is required by the client and
# ignored by Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ── Cloud provider ───────────────────────────────────────────────────────────
# Only needed when NEURA_ROLE_MAP is `cloud-prod` or `hybrid`. Leave commented
# to stay fully local — `ollama-dev` needs none of this.
#
# Any OpenAI-compatible endpoint works. Gemini's is shown; the same key you use
# for the eval judge below works here too.
#
# CLOUD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CLOUD_LLM_API_KEY=
#
# Which model serves which ROLE. `hybrid` keeps router/guard/embedder on local
# Ollama and only needs the two below; `cloud-prod` needs all five.
#
# CLOUD_MODEL_REASONER=gemini-2.5-flash
# CLOUD_MODEL_SUMMARIZER=gemini-2.5-flash
#
# cloud-prod only:
# CLOUD_MODEL_ROUTER=gemini-2.5-flash-lite
# CLOUD_MODEL_GUARD=gemini-2.5-flash-lite
# CLOUD_MODEL_EMBEDDER=gemini-embedding-001
# CLOUD_EMBEDDING_DIMENSIONS=3072
#
# ⚠ Changing CLOUD_MODEL_EMBEDDER changes the vector size. Vectors from
#   different embedding models are NOT comparable and mixing them degrades
#   retrieval SILENTLY. Follow the reindex procedure in
#   docs/architecture/llm-abstraction.md §5.2 — never just edit this line.

# Per-million-token prices, so cost per conversation is tracked rather than
# guessed. Unknown models are recorded as $0 and logged.
# LLM_PRICING_JSON={"gemini-2.5-flash":{"input":0.30,"output":2.50}}

# ── Eval judge ───────────────────────────────────────────────────────────────
# An AI that grades the agent's answers. It must be a STRONG model: a weak model
# grading a weak model produces numbers that look like measurements and are not.
# See docs/architecture/evaluation-strategy.md §3.1.
#
# Leave these unset and the harness still runs — it falls back to local Ollama
# and labels every score UNTRUSTED on the report. Nothing silently pretends.
#
# Any OpenAI-compatible endpoint works. Gemini's is below; a free tier is enough
# for evals at this scale.
#
#   1. Get a key at https://aistudio.google.com/apikey
#   2. Uncomment the three lines below and paste it into EVAL_JUDGE_API_KEY
#   3. make eval
#
# ⚠ FREE TIERS MAY TRAIN ON WHAT YOU SEND THEM.
#   Fine now — every eval case is invented test data.
#   NOT fine once real customer conversations are in the datasets: move to a
#   paid tier before that day. Tracked in docs/open-questions.md E2.
#
# ⚠ A FREE TIER CANNOT COMPLETE ONE RUN. Measured 2026-07-29: 20 requests/day,
#   exhausted partway through 35 cases, so groundedness existed for one dataset
#   and was unknown for the other four. Unjudged cases are SKIPPED rather than
#   scored, so the report stays honest — but a gate that cannot be measured is
#   not a gate. The suite is now 47 cases.
#
# ⚠ PIN THE MODEL. Never `-latest`: an alias that changes silently makes this
#   month's scores incomparable with last month's and leaves no trace in any
#   report. Models are also retired for new API projects without notice —
#   `gemini-2.5-flash` was named here until 1.13 and now 404s.
#
# EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=gemini-3.6-flash

# Fallback judge when EVAL_JUDGE_* is unset. Untrusted by definition.
# OLLAMA_JUDGE_MODEL=qwen3.5:9b

# ── Budgets ──────────────────────────────────────────────────────────────────
# Platform defaults. A tenant that sets its own in `tenants.config` overrides
# them; a tenant that does not behaves exactly as the system did before tenancy
# existed. Soft → fewer tool calls, hard → empty tool allowlist, so every turn
# escalates to a person. Neither rung is ever an error the shopper sees
# (docs/architecture/adr/0015-usage-rollups-and-budget-degradation.md).
#
# Reachable since milestone 1.14: every turn records a `UsageDelta`, so
# `spend_today` is a real number and these ceilings actually bite. Read what a
# tenant has used with `make tenant-usage TENANT=tn_...`.
BUDGET_DAILY_COST_USD_SOFT=8.00
BUDGET_DAILY_COST_USD_HARD=12.00
BUDGET_CONVERSATION_MAX_TOKENS=40000
BUDGET_CONVERSATION_MAX_LLM_CALLS=25
BUDGET_TURN_MAX_TOOL_CALLS=4

# ── Rate limits ──────────────────────────────────────────────────────────────
# A request is checked against several subjects at once and all must pass; the
# response headers report the tightest. `tenant` and `key` always apply; a
# public (fn_pk_) key additionally gets `client` and `conversation`, because one
# widget key is the shop and not the shopper
# (docs/architecture/adr/0017-rate-limit-subjects.md).
#
# EVERY NUMBER HERE IS A GUESS. Informed starting points, not measurements —
# nothing here has seen a real shopper. Recalibrate at ~100 real conversations,
# the same trigger as open question E3.
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_PER_TENANT=600
RATE_LIMIT_PER_KEY=600
# Sized for a shared address — an office or a household behind one NAT — because
# that is what an IP identifies.
RATE_LIMIT_PER_CLIENT=40
RATE_LIMIT_PER_CONVERSATION=20

# How many proxies sit in front of this deployment.
#
# ZERO MEANS `X-Forwarded-For` IS IGNORED ENTIRELY, which is the only safe
# default: the header is attacker-controlled, and trusting it lets a caller
# rotate the narrowest rate-limit subject at will while the limiter carries on
# reporting perfectly plausible numbers. Set it to the number of hops YOUR
# infrastructure adds — it is a fact about your topology, and if you do not know
# it, leave it at 0.
NEURA_TRUSTED_PROXY_HOPS=0

# ── Conversations ────────────────────────────────────────────────────────────
# How many previous turns are replayed into a prompt. Bounded because history is
# tokens: an unbounded transcript is an unbounded bill and, eventually, a context
# window that truncates the part that mattered.
CONVERSATION_HISTORY_TURNS=6

# ── Observability ────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=neura-api

LANGFUSE_ENABLED=false
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ── Retention (days) ─────────────────────────────────────────────────────────
# Deletion must fan out across Postgres, Redis, pgvector and traces —
# see docs/architecture/security-model.md §6.2.
RETENTION_CONVERSATIONS_DAYS=90
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_TRACES_DAYS=30

# ── Widget ───────────────────────────────────────────────────────────────────
# Comma-separated origins for fn_pk_ public keys. Never use "*" — public keys
# are, by definition, exposed in the browser.
WIDGET_ALLOWED_ORIGINS=http://localhost:3000
